{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gitmereba",
  "identifier": "com.mereba.gitmereba",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "principal",
        "title": "gitmereba",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'",
      "freezePrototype": true,
      "capabilities": ["principal"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
